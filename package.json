{
  "name": "commentatorbot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/prompts dist/data && cp src/prompts/*.md dist/prompts/ && cp src/data/*.json dist/data/",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "dev:local": "ENV_FILE=.env.dev ts-node src/main.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:eval": "tsc -p tsconfig.eval.json --noEmit",
    "eval:commentary": "tsc -p tsconfig.eval.json && node .eval-dist/scripts/eval-commentary/run.js",
    "eval:commentary:fixture": "tsc -p tsconfig.eval.json && node .eval-dist/scripts/eval-commentary/createFixture.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.41.1",
    "mysql2": "^3.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/mariadb": "^12.2.0",
    "@types/node": "^25.5.0",
    "eslint": "^10.11.0",
    "testcontainers": "^12.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
